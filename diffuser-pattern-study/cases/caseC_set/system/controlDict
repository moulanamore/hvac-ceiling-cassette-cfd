FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     buoyantPimpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;     endTime 1200;
deltaT          0.02;
writeControl    adjustableRunTime;  writeInterval 100;  purgeWrite 0;
writeFormat     binary;  writePrecision 8;  writeCompression off;
timeFormat      general; timePrecision 6;  runTimeModifiable yes;
adjustTimeStep  yes;  maxCo 10;  maxDeltaT 0.5;
functions
{
    returnT1 { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name c1_return; operation areaAverage; fields (T); writeFields false; writeControl timeStep; writeInterval 20; log true; }
    returnT2 { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name c2_return; operation areaAverage; fields (T); writeFields false; writeControl timeStep; writeInterval 20; log true; }
    meanT    { type volFieldValue;     libs (fieldFunctionObjects); regionType all;                operation volAverage;  fields (T); writeFields false; writeControl timeStep; writeInterval 20; log true; }
    average  { type fieldAverage; libs (fieldFunctionObjects); timeStart 1000; writeControl writeTime;
               fields ( U { mean on; prime2Mean off; base time; } T { mean on; prime2Mean off; base time; } ); }
}
